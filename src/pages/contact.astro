---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="Contact Us" description="Contact Precision Auto Diagnostics & Repair in Sacramento, CA. Call +1 (916) 927-4126. Located at 3250 Auburn Blvd, Sacramento, CA 95821.">
  <Header />

  <!-- Page Banner -->
  <section class="relative py-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/contact01.jpg" alt="Contact Precision Auto Sacramento" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-brand/85"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="font-display font-bold text-4xl lg:text-5xl text-white mb-3">Contact Us</h1>
      <p class="text-blue-200 text-lg max-w-xl mx-auto">Request service or ask us a question. We're here to help.</p>
      <nav class="mt-4 text-blue-300 text-sm">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">Contact</span>
      </nav>
    </div>
  </section>

  <!-- APPOINTMENT FORM SPLIT -->
  <section class="py-0 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <!-- Image left -->
        <div class="hidden lg:block">
          <img src="/images/contact02.jpg" alt="Auto repair Sacramento" class="w-full h-full object-cover min-h-96" />
        </div>
        <!-- Form right -->
        <div class="px-8 lg:px-16 py-16">
          <h2 class="font-display font-bold text-3xl lg:text-4xl text-gray-900 mb-2">Set up an appointment.</h2>
          <div class="w-12 h-1 bg-accent mb-5"></div>
          <p class="text-gray-500 mb-8">Fill out the form below and our team will get back to you shortly to confirm your appointment.</p>

          <form action="https://formsubmit.co/roccify@gmail.com" method="POST" class="space-y-4">
            <input type="hidden" name="_next" value="/thank-you" />
            <input type="hidden" name="_subject" value="Service Appointment Request - Precision Auto" />
            <input type="hidden" name="_captcha" value="false" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <input type="text" name="name" placeholder="Name *" required class="w-full px-4 py-3 border border-gray-300 rounded text-sm text-gray-800 focus:outline-none focus:border-brand" />
              <input type="email" name="email" placeholder="Email *" required class="w-full px-4 py-3 border border-gray-300 rounded text-sm text-gray-800 focus:outline-none focus:border-brand" />
            </div>

            <div class="flex items-center border border-gray-300 rounded overflow-hidden">
              <span class="px-3 text-gray-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </span>
              <input type="tel" name="phone" placeholder="Phone number" class="w-full px-3 py-3 text-sm text-gray-800 focus:outline-none" />
            </div>

            <textarea name="message" placeholder="Describe your vehicle's issue or service needed ..." rows="4" class="w-full px-4 py-3 border border-gray-300 rounded text-sm text-gray-800 focus:outline-none focus:border-brand resize-none"></textarea>

            <button type="submit" class="w-full py-4 bg-brand hover:bg-brand-dark text-white font-bold text-sm rounded transition-colors">
              Get an Appointment
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Info Cards -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="text-center p-8 border border-gray-200 rounded hover:border-brand hover:shadow-md transition-all">
          <div class="w-14 h-14 bg-brand rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl text-gray-900 mb-2">Phone</h3>
          <a href="tel:+19169274126" class="text-brand font-semibold hover:text-accent transition-colors">+1 (916) 927-4126</a>
        </div>
        <div class="text-center p-8 border border-gray-200 rounded hover:border-brand hover:shadow-md transition-all">
          <div class="w-14 h-14 bg-brand rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl text-gray-900 mb-2">Address</h3>
          <p class="text-gray-500 text-sm">3250 Auburn Blvd<br />Sacramento, CA 95821</p>
        </div>
        <div class="text-center p-8 border border-gray-200 rounded hover:border-brand hover:shadow-md transition-all">
          <div class="w-14 h-14 bg-brand rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl text-gray-900 mb-2">Hours</h3>
          <p class="text-gray-500 text-sm">Mon–Fri: 8:00 AM – 6:00 PM<br /><span class="text-xs text-gray-400">Update hours in contact.astro</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="bg-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 pb-16">
      <h3 class="font-display font-bold text-2xl text-gray-800 mb-2">Find Us</h3>
      <p class="text-gray-500 text-sm mb-6">3250 Auburn Blvd, Sacramento, CA 95821 · Proudly serving Sacramento and surrounding areas</p>
      <a
        href="https://www.google.com/maps/search/?api=1&query=3250+Auburn+Blvd+Sacramento+CA+95821"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-6 py-3 bg-brand text-white font-semibold rounded hover:bg-brand-dark transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Get Directions
      </a>
    </div>
  </section>

  <Footer />
</MainLayout>
