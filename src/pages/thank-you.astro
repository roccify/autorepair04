---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="Thank You">
  <Header />

  <section class="min-h-[60vh] flex items-center py-24 bg-gray-50">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <div class="w-20 h-20 bg-brand rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="font-display font-bold text-3xl lg:text-4xl text-gray-900 mb-4">Thank You!</h1>
      <p class="text-gray-500 text-lg leading-relaxed mb-3">
        Thank you for contacting Precision Auto Diagnostics & Repair.
      </p>
      <p class="text-gray-500 mb-8">
        We will get back to you shortly to confirm your appointment. If you need immediate assistance, please call us at <a href="tel:+19169274126" class="text-brand font-semibold hover:text-accent transition-colors">+1 (916) 927-4126</a>.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/" class="inline-flex items-center px-6 py-3 bg-brand text-white font-semibold rounded hover:bg-brand-dark transition-colors">
          Back to Home
        </a>
        <a href="/services" class="inline-flex items-center px-6 py-3 border-2 border-brand text-brand font-semibold rounded hover:bg-brand hover:text-white transition-colors">
          View Services
        </a>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>
