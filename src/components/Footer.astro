---
---
<footer class="relative bg-brand text-white overflow-hidden">
  <!-- Left image strip -->
  <div class="absolute left-0 top-0 bottom-0 w-56 hidden lg:block">
    <img src="/images/team01.jpg" alt="Precision Auto technician" class="w-full h-full object-cover opacity-80" />
    <div class="absolute inset-0 bg-gradient-to-r from-transparent to-brand"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:pl-72">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
          </svg>
          <span class="font-display font-bold text-xl">Precision Auto</span>
        </div>
        <p class="text-blue-200 text-sm leading-relaxed mb-5">
          ASE-certified mechanics offering modern diagnostics, transparent pricing, and efficient turnaround for daily drivers and fleet vehicles in Sacramento since 2011.
        </p>
        <hr class="border-blue-400 mb-5" />
        <div class="flex items-center gap-2 text-sm text-accent font-semibold">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Opening hours : Mon–Fri 8h–18h
        </div>
      </div>

      <!-- Links -->
      <div>
        <h4 class="font-display font-bold text-lg mb-4">Quick Links</h4>
        <nav class="space-y-2">
          <a href="/" class="block text-blue-200 hover:text-white text-sm transition-colors">Home</a>
          <a href="/services" class="block text-blue-200 hover:text-white text-sm transition-colors">Our Services</a>
          <a href="/about" class="block text-blue-200 hover:text-white text-sm transition-colors">About Us</a>
          <a href="/contact" class="block text-blue-200 hover:text-white text-sm transition-colors">Contact</a>
        </nav>
      </div>

      <!-- Contact / Appointment Form -->
      <div>
        <h4 class="font-display font-bold text-lg mb-4">Request Service</h4>
        <form action="https://formsubmit.co/roccify@gmail.com" method="POST" class="space-y-3">
          <input type="hidden" name="_next" value="/thank-you" />
          <input type="hidden" name="_subject" value="New Service Request from Precision Auto Website" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="text" name="name" placeholder="Your name ... *" required class="w-full px-4 py-3 bg-brand-light border border-blue-400 text-white placeholder-blue-300 text-sm rounded focus:outline-none focus:border-accent" />
          <input type="email" name="email" placeholder="Insert your email ... *" required class="w-full px-4 py-3 bg-brand-light border border-blue-400 text-white placeholder-blue-300 text-sm rounded focus:outline-none focus:border-accent" />
          <input type="text" name="service" placeholder="Service needed ..." class="w-full px-4 py-3 bg-brand-light border border-blue-400 text-white placeholder-blue-300 text-sm rounded focus:outline-none focus:border-accent" />
          <button type="submit" class="w-full py-3 bg-accent hover:bg-accent-dark text-dark font-bold text-sm rounded transition-colors">
            Get an Appointment
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-blue-500 mt-4">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-blue-300">
      <p>© 2011–2026 · Precision Auto Diagnostics & Repair · Sacramento, CA · All Rights Reserved</p>
      <div class="flex items-center gap-4">
        <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
        </a>
        <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" stroke-width="2"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2" stroke-linecap="round"/></svg>
        </a>
        <a href="https://google.com" target="_blank" rel="noopener" aria-label="Google" class="hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        </a>
        <a href="https://yelp.com" target="_blank" rel="noopener" aria-label="Yelp" class="hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.5 2C6.979 2 2.5 6.479 2.5 12s4.479 10 10 10 10-4.479 10-10S18.021 2 12.5 2zm-1 14.5v-5l4.5 2.5-4.5 2.5zm0-7V5l4.5 2.5L11.5 9.5z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
