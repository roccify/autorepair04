---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services', dropdown: [
    { label: 'Brake Repair & Replacement', href: '/services#brakes' },
    { label: 'Engine Diagnostics', href: '/services#engine' },
    { label: 'Transmission Service', href: '/services#transmission' },
    { label: 'AC & Heating Repair', href: '/services#ac' },
    { label: 'Suspension & Steering', href: '/services#suspension' },
    { label: 'Oil Change & Maintenance', href: '/services#oil' },
  ]},
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<!-- Top Bar -->
<div class="bg-brand text-white text-sm py-2">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-6">
      <a href="tel:+19169274126" class="flex items-center gap-2 hover:text-accent transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Call us : +1 (916) 927-4126
      </a>
      <span class="hidden sm:flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Opening hours : Mon–Fri 8h–18h
      </span>
    </div>
    <div class="flex items-center gap-3">
      <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-accent transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
      </a>
      <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-accent transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" stroke-width="2"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2" stroke-linecap="round"/></svg>
      </a>
      <a href="https://google.com" target="_blank" rel="noopener" aria-label="Google" class="hover:text-accent transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
      </a>
      <a href="https://yelp.com" target="_blank" rel="noopener" aria-label="Yelp" class="hover:text-accent transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.5 2C6.979 2 2.5 6.479 2.5 12s4.479 10 10 10 10-4.479 10-10S18.021 2 12.5 2zm-1 14.5v-5l4.5 2.5-4.5 2.5zm0-7V5l4.5 2.5L11.5 9.5z"/></svg>
      </a>
    </div>
  </div>
</div>

<!-- Main Nav -->
<nav class="bg-white shadow-md sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
        </svg>
        <div>
          <div class="font-display font-bold text-brand text-lg lg:text-xl leading-tight">Precision Auto</div>
          <div class="text-xs text-gray-500 leading-tight hidden sm:block">Diagnostics & Repair</div>
        </div>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map(item => (
          <div class="relative group">
            {item.dropdown ? (
              <>
                <button class={`px-4 py-2 font-semibold text-sm rounded transition-colors flex items-center gap-1 ${currentPath.startsWith('/services') ? 'text-brand' : 'text-gray-700 hover:text-brand'}`}>
                  {item.label}
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="absolute top-full left-0 bg-white shadow-xl border-t-2 border-brand min-w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  {item.dropdown.map(sub => (
                    <a href={sub.href} class="block px-5 py-3 text-sm text-gray-700 hover:bg-brand hover:text-white transition-colors border-b border-gray-100 last:border-0">
                      {sub.label}
                    </a>
                  ))}
                </div>
              </>
            ) : (
              <a href={item.href} class={`px-4 py-2 font-semibold text-sm rounded transition-colors block ${currentPath === item.href ? 'text-brand' : 'text-gray-700 hover:text-brand'}`}>
                {item.label}
              </a>
            )}
          </div>
        ))}
      </div>

      <!-- CTA + Hamburger -->
      <div class="flex items-center gap-3">
        <a href="/contact" class="hidden lg:inline-flex items-center px-5 py-2 bg-brand text-white font-semibold text-sm rounded hover:bg-brand-dark transition-colors border-2 border-brand hover:border-brand-dark">
          Request Service
        </a>
        <button id="hamburger" aria-label="Open menu" class="lg:hidden p-2 text-brand">
          <svg id="ham-icon" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="close-icon" class="w-7 h-7 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-200 shadow-lg">
    <div class="px-6 py-4 space-y-1">
      <a href="/" class="block py-3 font-semibold text-gray-700 border-b border-gray-100 hover:text-brand transition-colors">Home</a>
      
      <!-- Mobile Services Dropdown -->
      <div>
        <button id="mobile-services-toggle" class="w-full flex items-center justify-between py-3 font-semibold text-gray-700 border-b border-gray-100 hover:text-brand transition-colors">
          Services
          <svg id="services-arrow" class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div id="mobile-services-list" class="hidden pl-4 space-y-1 pb-2">
          <a href="/services#brakes" class="block py-2 text-sm text-gray-600 hover:text-brand transition-colors">Brake Repair & Replacement</a>
          <a href="/services#engine" class="block py-2 text-sm text-gray-600 hover:text-brand transition-colors">Engine Diagnostics</a>
          <a href="/services#transmission" class="block py-2 text-sm text-gray-600 hover:text-brand transition-colors">Transmission Service</a>
          <a href="/services#ac" class="block py-2 text-sm text-gray-600 hover:text-brand transition-colors">AC & Heating Repair</a>
          <a href="/services#suspension" class="block py-2 text-sm text-gray-600 hover:text-brand transition-colors">Suspension & Steering</a>
          <a href="/services#oil" class="block py-2 text-sm text-gray-600 hover:text-brand transition-colors">Oil Change & Maintenance</a>
        </div>
      </div>

      <a href="/about" class="block py-3 font-semibold text-gray-700 border-b border-gray-100 hover:text-brand transition-colors">About</a>
      <a href="/contact" class="block py-3 font-semibold text-gray-700 border-b border-gray-100 hover:text-brand transition-colors">Contact</a>
      
      <!-- Mobile Phone in menu -->
      <div class="pt-3 pb-1">
        <a href="tel:+19169274126" class="flex items-center justify-center gap-2 w-full py-3 bg-brand text-white font-semibold rounded">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call Now — +1 (916) 927-4126
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamIcon = document.getElementById('ham-icon');
  const closeIcon = document.getElementById('close-icon');
  const phoneBar = document.getElementById('mobile-phone-bar');
  const mobileServicesToggle = document.getElementById('mobile-services-toggle');
  const mobileServicesList = document.getElementById('mobile-services-list');
  const servicesArrow = document.getElementById('services-arrow');

  let menuOpen = false;

  hamburger?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenu?.classList.toggle('hidden', !menuOpen);
    hamIcon?.classList.toggle('hidden', menuOpen);
    closeIcon?.classList.toggle('hidden', !menuOpen);
    if (phoneBar) phoneBar.style.display = menuOpen ? 'none' : '';
  });

  mobileServicesToggle?.addEventListener('click', () => {
    const isHidden = mobileServicesList?.classList.contains('hidden');
    mobileServicesList?.classList.toggle('hidden', !isHidden);
    servicesArrow?.classList.toggle('rotate-180', isHidden);
  });
</script>
